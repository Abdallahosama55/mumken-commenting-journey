{
  "expo": {
    "name": "Commenting Journey",
    "slug": "commenting-journey",
    "scheme": "commentingjourney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.abdallahosama.commentingjourney"
    },
    "android": {
      "package": "dev.abdallahosama.commentingjourney",
      "adaptiveIcon": {
        "backgroundColor": "#1F2A33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      ["expo-localization", { "supportsRTL": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

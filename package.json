{
  "name": "mumken-commenting-journey",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @commenting/web",
    "dev:mobile": "npm run start -w @commenting/mobile",
    "build:web": "npm run build -w @commenting/web",
    "start:web": "npm run start -w @commenting/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:core": "npm test -w @commenting/core",
    "test:web": "npm test -w @commenting/web",
    "test:mobile": "npm test -w @commenting/mobile",
    "test:e2e": "npm run test:e2e -w @commenting/web",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "expo-router": "~58.0.28"
  }
}
